@model UserViewModel
@using MajorDecision.Web.Models.ViewModels
@using Microsoft.AspNetCore.Identity

@{
    ViewBag.Title = "Profile info";
}

@if (TempData["msg"] != null)
{
    <div class="alert alert-info alert-dismissible fade show text-center" role="alert">
        @TempData["msg"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0" style="background-color:peachpuff">
                <div class="card-body p-4">
                    <div class="row align-items-center">
                        <div class="col-md-4 text-center mb-3 mb-md-0">
                            <img src="@ViewData["Photo"]"
                                 style="width: 180px; height: 180px; border-radius: 50%; object-fit: cover; border: 4px solid #eee;"
                                 alt="@Model.Username" />

                            @if (Model.Roles.Any())
                            {
                                <div class="mt-3">
                                    @foreach (var role in Model.Roles)
                                    {
                                        <span class="badge bg-secondary me-1">@role</span>
                                    }
                                </div>
                            }
                        </div>

                        <div class="col-md-8">
                            <h2 class="mb-1 text-black">@Model.FirstName</h2>
                            <p class="text-muted mb-3">@@@Model.Username</p>

                            <ul class="list-group list-group-flush">
                                <li class="list-group-item d-flex justify-content-between bg-transparent">
                                    <span class="text-muted">Username</span>
                                    <span>@Model.Username</span>
                                </li>
                                <li class="list-group-item d-flex justify-content-between bg-transparent">
                                    <span class="text-muted">Email</span>
                                    <span>@Model.Email</span>
                                </li>
                                <li class="list-group-item d-flex justify-content-between bg-transparent">
                                    <span class="text-muted">Role</span>
                                    <span>@Model.Roles.First()</span>
                                </li>
                            </ul>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>