@using MajorDecision.Data.Services.Implementation
@model List<NotificationVM>

@if (TempData["AlertMessage"] != null)
{
    <div class="alert alert-info" style="text-align:center">
        @TempData["AlertMessage"]
        <button type="button" class="btn btn-close" data-bs-dismiss="alert" style="float:right">
            @*<span>&times;</span>*@
        </button>

    </div>
}
@if (Model.Count > 0)
{
    <table class="" style="text-align:center; margin-top:15px" width="100%">
        <thead>
            <tr>
                <th></th>
                <th></th>
            </tr>
        </thead>
        <tbody style="font-size:larger">
            @foreach (var item in Model)
            {
                if (item.Type == "Action")
                {
                    <tr>
                        <td width="80%">@item.Message</td>
                        <td>
                            <div class="w-40 btn-group" role="group">
                                <form asp-controller="Profile" asp-action="AcceptRequestToFriend" method="post" asp-route-senderId="@item.SenderId">
                                    <button type="submit" class="btn btn-outline-secondary" style="margin-right:10px">Accept</button>
                                </form>

                                <form asp-controller="Profile" asp-action="DeclineRequestToFriend" method="post" asp-route-senderId="@item.SenderId">
                                    <button type="submit" class="btn btn-outline-danger">Decline</button>
                                </form>
                                @* <a asp-controller="Profile" asp-action="AcceptRequestToFriend" asp-route-senderId="@item.SenderId" class="btn btn-outline-secondary">Accept</a>
                        <a asp-controller="Profile" asp-action="DeclineRequesToFriend" asp-route-senderId="@item.SenderId" class="btn btn-outline-secondary">Decline</a> *@
                            </div>
                        </td>
                        @* <td><a class="btn btn-outline-secondary" asp-controller="DiscussionPage" asp-action="CreatePage" asp-route-id="@item.Id">Publish</a></td> *@
                    </tr>
                }
                else
                {
                    <tr>
                        <td>@item.Message</td>
                        <td>
                            <div class="w-55 btn-group" role="group">
                                <form asp-controller="Profile" asp-action="ReadCheckConfirmNotification" method="post" asp-route-id="@item.Id">
                                    <button type="submit" class="btn btn-outline-secondary">OK</button>
                                </form>
                                @* <a asp-controller="Profile" asp-action="AcceptRequestToFriend" asp-route-senderId="@item.SenderId" class="btn btn-outline-secondary">Accept</a>
                        <a asp-controller="Profile" asp-action="DeclineRequesToFriend" asp-route-senderId="@item.SenderId" class="btn btn-outline-secondary">Decline</a> *@
                            </div>
                        </td>
                        @* <td><a class="btn btn-outline-secondary" asp-controller="DiscussionPage" asp-action="CreatePage" asp-route-id="@item.Id">Publish</a></td> *@
                    </tr>
                }
            }
        </tbody>

    </table>
}
else
{
    <p class="text-center m-3">
        <b>No notifications</b>
        <br />
        <br />
        <b>
            @* <a class="nav-link text-dark" asp-area="" asp-controller="Decision" asp-action="Index">Try again</a> *@
            <a class="btn btn-secondary" style="width:250px" asp-area="" asp-controller="Decision" asp-action="Index">Question!</a>
        </b>
    </p>
}

